{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "./scripts/vercel-build.sh",
  "outputDirectory": "vercel-static",
  "functions": {
    "api/index.py": {
      "includeFiles": "{backend/**,frontend/templates/**,shared/**}",
      "maxDuration": 60
    }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index" }
  ]
}
