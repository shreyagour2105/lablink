{
  "name": "lablink",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && esbuild frontend/src/app.ts frontend/src/faculty.ts --bundle --minify --format=esm --target=es2022 --outdir=frontend/dist",
    "dev:assets": "esbuild frontend/src/app.ts frontend/src/faculty.ts --bundle --format=esm --target=es2022 --outdir=frontend/dist --watch"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@firebase/app": "0.16.2",
    "@firebase/auth": "1.13.6"
  }
}
